# Set to true to test without connecting to Twitch.
MOCK=true
PORT=3000

# Twitch channel name, without the #.
TWITCH_CHANNEL=your_channel

# Needed only when MOCK=false and connecting Twitch EventSub.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Register this exact URL as an OAuth Redirect URL in your Twitch app.
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
